# Bodhan hosted API — one key per model, issued from https://console.bodhan.ai/
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# Base URL for the Bodhan OpenAI-compatible API.
BODHAN_BASE_URL=https://api.bodhan.ai/v1

# The general-purpose LLM that acts as the agent's brain.
# Any OpenAI-compatible endpoint with tool calling.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional: where cached model responses are stored (default .cache/)
BODHAN_CACHE_DIR=.cache

   "source": [
    "# Example: function to push content to YPNUS.com\n",
    "# Update endpoint path and payload shape to match YPNUS API docs\n",
    "YPNUS_API_BASE = 'https://api.ypnus.com/v1'  # replace with actual base URL from docs\n",
    "\n",
    "def push_page_to_ypnus(title: str, body_html: str, zip_code: str = None) -> dict:\n",
    "    url = f'{YPNUS_API_BASE}/pages'  # example endpoint — change as needed\n",
    "    headers = {\n",
    "        'Authorization': f'Bearer {YPNUS_API_KEY}',\n",
    "        'Content-Type': 'application/json'\n",
    "    }\n",
    "    payload = {\n",
    "        'title': title,\n",
    "        'content_html': body_html,\n",
    "        'territory_zip': zip_code,\n",
    "    }\n",
    "    resp = requests.post(url, json=payload, headers=headers)\n",
    "    resp.raise_for_status()\n",
    "    return resp.json()\n",
    "\n",
    "# Example usage (fill real prompt and endpoint fields):\n",
    "prompt = 'Write a concise, high-converting landing page for a mortgage broker serving 90210; include call-to-action and local SEO headings.'\n",
    "generated = generate_marketing_content(prompt)\n",
    "print('Generated preview:\n', generated)\n",
